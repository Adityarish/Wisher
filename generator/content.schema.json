{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wishcraft.local/content.schema.json",
  "title": "WishCraft project content",
  "type": "object",
  "required": ["occasion", "template_id"],
  "anyOf": [{"required": ["title"]}, {"required": ["message"]}],
  "properties": {
    "project_slug": {"type": "string", "pattern": "^([a-z0-9]+(?:-[a-z0-9]+)*)?$"},
    "occasion": {"type": "string"},
    "template_id": {"type": "integer", "minimum": 1},
    "recipient_names": {"type": "array", "items": {"type": "string"}},
    "sender_name": {"type": "string"},
    "relationship": {"type": "string"},
    "language": {"type": "string"},
    "title": {"type": "string"},
    "subtitle": {"type": "string"},
    "message": {"type": "string"},
    "letter": {"type": "string"},
    "closing_message": {"type": "string"},
    "reveal_message": {"type": "string"},
    "age_or_milestone": {"type": ["string", "number", "null"]},
    "event_datetime": {"type": ["string", "null"], "format": "date-time"},
    "timezone": {"type": "string"},
    "couple_names": {"type": "array", "items": {"type": "string"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "gallery": {"type": "array", "items": {"$ref": "#/$defs/mediaItem"}},
    "videos": {"type": "array", "items": {"$ref": "#/$defs/mediaItem"}},
    "voice_messages": {"type": "array", "items": {"$ref": "#/$defs/mediaItem"}},
    "timeline": {"type": "array", "items": {"$ref": "#/$defs/storyItem"}},
    "memory_cards": {"type": "array", "items": {"$ref": "#/$defs/card"}},
    "appreciation_cards": {"type": "array", "items": {"$ref": "#/$defs/card"}},
    "quotes": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"type": "object", "properties": {"text": {"type": "string"}, "author": {"type": "string"}}}] }},
    "button_labels": {"type": "object", "additionalProperties": {"type": "string"}},
    "theme": {"$ref": "#/$defs/theme"},
    "media": {"type": "object", "properties": {"hero": {"type": ["string", "null"]}, "background_music": {"type": ["string", "null"]}, "social_preview": {"type": ["string", "null"]}, "hero_focal_position": {"type": "string"}}},
    "gif_roles": {"type": "object", "additionalProperties": {"type": "string"}},
    "sticker_roles": {"type": "object", "additionalProperties": {"type": "string"}},
    "sections": {"type": "array", "items": {"type": "string"}},
    "section_options": {"type": "object"},
    "opening_interaction": {"type": "string"},
    "music_enabled": {"type": "boolean"},
    "countdown_enabled": {"type": "boolean"},
    "branding_credit": {"type": "boolean"},
    "gif_theme": {"type": "string", "description": "auto, none, or a folder name/keyword inside WishCraft_GIF_Collection"},
    "gif_pack_size": {"type": "integer", "minimum": 0, "maximum": 12},
    "wow_effects": {"type": "boolean"},
    "reasons": {"type": "array", "items": {"type": "string"}, "description": "Your own reasons; the rest are filled from the built-in 100"},
    "reasons_count": {"type": "integer", "minimum": 0, "maximum": 500},
    "reasons_fill_defaults": {"type": "boolean"},
    "love_letter_animation": {"type": "boolean"},
    "collage_layout": {"type": "object", "description": "Saved by Edit mode: {picture-path: {c: columns 1-6, r: rows 1-8}}"},
    "edit_mode_button": {"type": "boolean"},
    "gif_rail": {"type": "boolean"},
    "intro_splash": {"type": "boolean"},
    "site_nav": {"type": "boolean"},
    "share_enabled": {"type": "boolean"},
    "love_particles": {"type": "string", "enum": ["auto", "hearts", "confetti", "stars", "none"]}
  },
  "$defs": {
    "mediaItem": {"type": "object", "required": ["src"], "properties": {"src": {"type": "string"}, "caption": {"type": "string"}, "alt": {"type": "string"}, "poster": {"type": "string"}}},
    "storyItem": {"type": "object", "properties": {"date": {"type": "string"}, "title": {"type": "string"}, "description": {"type": "string"}}},
    "card": {"oneOf": [{"type": "string"}, {"type": "object", "properties": {"title": {"type": "string"}, "text": {"type": "string"}}}]},
    "event": {"type": "object", "properties": {"name": {"type": "string"}, "description": {"type": "string"}, "datetime": {"type": "string"}, "venue_name": {"type": "string"}, "address": {"type": "string"}, "map_url": {"type": "string", "format": "uri"}, "rsvp_url": {"type": "string", "format": "uri"}}},
    "theme": {"type": "object", "properties": {"palette": {"type": "string"}, "accent_color": {"type": "string"}, "font_pairing": {"type": "string"}, "appearance": {"enum": ["auto", "light", "dark"]}, "animation_intensity": {"enum": ["off", "subtle", "playful"]}, "decoration_density": {"enum": ["low", "medium", "high"]}}}
  }
}

